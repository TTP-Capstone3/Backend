# ============================================================
#  Environment variables
# ============================================================
# Copy this file to a new file named ".env" and fill in real values
# NEVER commit your real .env — it is git-ignored on purpose because it can hold secrets
#
#   cp .env.example .env
#
# process.env reads these values at runtime (e.g. process.env.PORT).

# The port your server listens on. Defaults to 8080 if unset.
# The production environment will provide a default PORT.

# The origin (URL) of your React frontend, so CORS lets it call this API.
# Defaults to the Vite dev server if unset. Set this to your deployed
# frontend URL in production.

FRONTEND_URL=http://localhost:5173

# ---------- Gemini AI ----------
# Get a key from Google AI Studio. Keep the real key in the backend .env only.
GEMINI_API_KEY=

# Gemini model to use.
GEMINI_MODEL=gemini-3.6-flash

# Local PostgreSQL connection string used by db/index.js during development.
# Replace the username and database name with values from your local setup.
LOCAL_DATABASE_URL=postgres://username@127.0.0.1:5432/capstone_demo

# Production database connection string. Leave this commented out locally.
# When set, it overrides LOCAL_DATABASE_URL and enables SSL settings.
# DATABASE_URL="postgres://user:password@host:5432/database_name"

# ---------- Auth0 ----------
# Used by middleware/auth.js to verify access tokens from your frontend.

# Your Auth0 tenant domain — NO https:// (e.g. dev-xxxx.us.auth0.com).
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The identifier of the API you created in the Auth0 dashboard (Applications >
# APIs > your API > Identifier). It is a name, not a URL you visit — Auth0 just
# happens to use URL-shaped names by convention.
#
# This must be BYTE-FOR-BYTE identical to the frontend's VITE_AUTH0_AUDIENCE.
# If they differ, login appears to work and then every API call returns 401 —
# by far the most common way to get stuck here.
AUTH0_AUDIENCE=https://capstone-api

# The namespace on the custom claims your Auth0 Post-Login Action adds (email,
# name). Must match the Action exactly — see "Post-Login Action" in the README.
# Not a secret, and it never has to be a real website.
AUTH0_CLAIMS_NAMESPACE=https://myapp.example.com

# ---------- our own JWT ----------
# Used by middleware/auth.js to SIGN the tokens we issue at /auth/signup and
# /auth/login, and to VERIFY them on the way back in.
#
# This is a REAL secret. Anyone who knows it can forge a token for ANY user,
# so it never goes in git and the deployed app gets a different value.
# Generate a strong one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts before the user has to sign in again.
# Accepts things like 15m, 24h, 7d.
JWT_EXPIRES_IN=7d
